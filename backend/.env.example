# Copy this file to .env and fill in real values before running.
# Never commit the real .env to version control.

ENVIRONMENT=development

# --- database ---
DATABASE_URL=postgresql+psycopg2://og_user:og_pass@localhost:5432/opportunitygenie

# --- auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-this-with-a-random-64-character-hex-string

# --- Supabase Auth (signup confirmation + password reset emails) ---
# Supabase dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=

# --- AI advisor ---
# Required for the /advisor/recommend endpoint. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- billing (Stripe) — leave blank until you're ready to charge for subscriptions ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM=
BILLING_SUCCESS_URL=https://your-domain.example.com/billing/success
BILLING_CANCEL_URL=https://your-domain.example.com/billing/cancel

# --- CORS: comma-separated list of origins allowed to call this API ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
